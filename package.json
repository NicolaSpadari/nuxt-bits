{
	"name": "nuxt-bits",
	"type": "module",
	"version": "0.1.6",
	"packageManager": "bun@1.3.3",
	"description": "Vue bits integration for Nuxt 3 & Nuxt 4",
	"license": "MIT",
	"repository": "NicolaSpadari/nuxt-bits",
	"exports": {
		".": {
			"types": "./dist/types.d.mts",
			"import": "./dist/module.mjs"
		}
	},
	"main": "./dist/module.mjs",
	"typesVersions": {
		"*": {
			".": [
				"./dist/types.d.mts"
			]
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"prepack": "nuxt-module-build build",
		"dev": "npm run dev:prepare && nuxi dev playground",
		"dev:build": "nuxi build playground",
		"dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxi prepare playground",
		"release": "npm run prepack && changelogen --release && npm publish && git push --follow-tags",
		"preinstall": "npx only-allow bun",
		"lint": "eslint . --fix"
	},
	"dependencies": {
		"@nuxt/kit": "^4.2.2",
		"@tailwindcss/postcss": "^4.1.18",
		"@tailwindcss/vite": "^4.1.18",
		"@vueuse/nuxt": "^14.1.0",
		"tailwindcss": "^4.1.18"
	},
	"devDependencies": {
		"@antfu/eslint-config": "^7.0.1",
		"@nuxt/devtools": "^3.1.1",
		"@nuxt/eslint": "1.5.2",
		"@nuxt/icon": "1.15.0",
		"@nuxt/image": "1.10.0",
		"@nuxt/module-builder": "^1.0.2",
		"@nuxt/schema": "^4.2.2",
		"@types/matter-js": "^0.20.2",
		"@types/node": "latest",
		"@types/three": "^0.182.0",
		"@vueuse/core": "^14.1.0",
		"changelogen": "^0.6.2",
		"eslint": "^9.39.2",
		"face-api.js": "^0.22.2",
		"gl-matrix": "^3.4.4",
		"gsap": "^3.14.2",
		"lenis": "^1.3.17",
		"mathjs": "^15.1.0",
		"matter-js": "^0.20.0",
		"motion-v": "^1.9.0",
		"nuxt": "^4.2.2",
		"ogl": "^1.0.11",
		"postprocessing": "^6.38.2",
		"three": "^0.182.0",
		"typescript": "^5.9.3",
		"vue-tsc": "^3.2.2"
	}
}
